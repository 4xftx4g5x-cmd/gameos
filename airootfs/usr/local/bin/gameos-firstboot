#!/usr/bin/env bash
# GameOS - configuração do primeiro boot do sistema instalado (precisa de internet).
# Instala Heroic (Epic/GOG) e ProtonUp-Qt (Proton-GE) via Flatpak e ativa serviços.
set -u

DONE=/var/lib/gameos/firstboot.done
mkdir -p "$(dirname "$DONE")"
[[ -e "$DONE" ]] && exit 0

# Espera a rede por até 2 minutos
for _ in $(seq 1 60); do
  if curl -fsS --max-time 3 https://flathub.org >/dev/null 2>&1; then online=1; break; fi
  sleep 2
done
[[ "${online:-0}" == 1 ]] || { echo "Sem internet; tentando de novo no próximo boot."; exit 1; }

flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
flatpak install -y --noninteractive flathub \
  com.heroicgameslauncher.hgl \
  net.davidotek.pupgui2 || exit 1

# Prefixos e atalhos de jogos devem poder usar GPU e gamemode
flatpak override --system --device=all com.heroicgameslauncher.hgl

systemctl enable --now fstrim.timer 2>/dev/null || true
touch "$DONE"
