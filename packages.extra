exfatprogs
zram-generator
networkmanager
wpa_supplicant
network-manager-applet
xterm

# --- Áudio ---
pipewire
pipewire-alsa
pipewire-pulse
wireplumber
lib32-pipewire
lib32-libpulse
pavucontrol
volumeicon

# --- Desktop ultraleve (X11 + Openbox + barra tint2, sem gerenciador de login) ---
