# HKOS - pacotes adicionados ao perfil releng do archiso
# Filosofia: só o necessário. Steam, Discord, navegador, drivers e o mínimo do sistema.
# (linhas vazias e comentários são ignorados pelo build.sh)

# --- Kernel otimizado (Zen) + firmware ---
linux-zen
linux-zen-headers
linux-firmware
sof-firmware
dkms

# --- Base mínima ---
sudo
git
nano
htop
dialog
earlyoom
pciutils
ntfs-3g
exfatprogs
zram-generator
networkmanager
wpa_supplicant
xterm

# --- Áudio ---
pipewire
pipewire-alsa
pipewire-pulse
wireplumber
lib32-pipewire
lib32-libpulse
pavucontrol

# --- Desktop ultraleve (X11 + Openbox + barra tint2, sem gerenciador de login) ---
xorg-server
xorg-xinit
xorg-xset
xorg-xrandr
xorg-xsetroot
xorg-xrdb
xf86-input-libinput
openbox
tint2
feh
adwaita-icon-theme

# --- Explorador de arquivos leve (discos, pendrives, lixeira) ---
pcmanfm
gvfs
udisks2

# --- Visual estilo Windows (notificações, Executar, botão Iniciar) ---
dunst
dmenu
xdotool

# --- Fontes (mínimo) ---
ttf-dejavu
ttf-liberation
noto-fonts-emoji

# --- Drivers de vídeo (AMD, Intel, NVIDIA) ---
mesa
lib32-mesa
vulkan-mesa-layers
lib32-vulkan-mesa-layers
vulkan-icd-loader
lib32-vulkan-icd-loader
vulkan-radeon
lib32-vulkan-radeon
vulkan-intel
lib32-vulkan-intel
intel-media-driver
libva-nvidia-driver
nvidia-open-dkms
nvidia-utils
nvidia-settings
lib32-nvidia-utils
intel-ucode
amd-ucode

# --- Jogos ---
steam
gamemode
lib32-gamemode
mangohud
lib32-mangohud
scx-scheds

# Battle.net (Lutris + Wine) e Gamescope NÃO vêm no ISO (mais leve): hkos-battlenet / hkos-loja instalam sob demanda.

# --- Aplicativos ---
discord
firefox
